# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- ClickHouse: local Docker (development) ---
# 127.0.0.1, NOT localhost. On Windows, localhost resolves to IPv6 ::1 first and
# Docker's port binding is IPv4-only, so every first connection stalls ~21 SECONDS
# waiting for the IPv6 attempt to time out before falling back. Measured:
#   http://localhost:8123  -> 21,612ms      first query through the gateway: 21,194ms
#   http://127.0.0.1:8123  ->    221ms      first query through the gateway:    118ms
# This alone cut a full investigation from 30.8s to 16.4s.
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=continuity_dev
CLICKHOUSE_DATABASE=continuity
CLICKHOUSE_SECURE=false

# --- ClickHouse: Cloud (demo deployment, from 2026-08-24) ---
# CLICKHOUSE_HOST=<instance>.<region>.aws.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_SECURE=true

# --- Synthetic data generation ---
# Deliberately NOT configured here. Generation parameters live in
# continuity/data/load.py as DEFAULT_SEED / DEFAULT_DAYS / DEFAULT_SESSIONS_PER_DAY,
# overridable per run with --seed / --days / --sessions-per-day:
#
#   uv run python -m continuity.data.load --days 56 --sessions-per-day 250000 --truncate
#
# They used to be listed here as CONTINUITY_SEED / CONTINUITY_DAYS /
# CONTINUITY_SESSIONS_PER_DAY, which nothing ever read, and CONTINUITY_DAYS said 21
# while every committed artefact (data/ground_truth.json, results/comparison.json, the
# integration windows) came from a 56-day dataset. Config that is unused AND wrong is
# worse than absent: it is authoritative-looking, gitignored so nobody reviews it, and
# it misled a reader into nearly reloading the database at the wrong size.
#
# The loader's defaults are committed in code and reviewed, which is a stronger
# reproducibility guarantee than an untracked env file ever was.

# --- Google Cloud (needed from sub-project 3 onward) ---
GOOGLE_CLOUD_PROJECT=agentic-hackathon-504919
# ADK reads GOOGLE_GENAI_USE_ENTERPRISE. GOOGLE_GENAI_USE_VERTEXAI still works but
# raises a DeprecationWarning on every agent construction (it was ~326 of 345 warnings
# in one test run). The rename tracks Vertex AI's rebrand to the Gemini Enterprise
# Agent Platform, which is the platform this project targets.
GOOGLE_GENAI_USE_ENTERPRISE=true

# Must be "global", not a region. Verified against the live API on 2026-08-08:
# every Gemini 3.x model 404s in us-central1 and serves only from the global
# endpoint. us-central1 offers nothing newer than the 2.5 generation.
GOOGLE_CLOUD_LOCATION=global

# Verified available on global: gemini-3.6-flash, gemini-3.5-flash,
# gemini-3.5-flash-lite, gemini-flash-latest, gemini-2.5-pro.
# NO Gemini 3.x Pro exists for this project (3.1/3.5/3.6-pro all 404), so
# gemini-2.5-pro is the only Pro tier available if Flash proves insufficient.
CONTINUITY_MODEL=gemini-3.6-flash
CONTINUITY_MODEL_HEAVY=gemini-3.6-flash

# Cloud Run deploys to a real region -- this is deliberately NOT the Vertex location.
CLOUD_RUN_REGION=us-central1
